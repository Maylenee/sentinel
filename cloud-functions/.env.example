# Environment EdgeOne (Project Settings -> Environment Variables).
# Untuk local `edgeone makers dev`, salin file ini menjadi .env di root project.

# URL publik backend FastAPI di VPS, tanpa trailing slash.
# Contoh: https://api.domain-anda.com
SENTINEL_API_URL=

# Samakan dengan SENTINEL_API_TOKEN di backend/.env.
# Cloud function mengirim header: Authorization: Bearer <token>.
SENTINEL_API_TOKEN=

# Batas waktu proxy ke backend. Maksimum EdgeOne Cloud Functions = 120000 ms.
SENTINEL_PROXY_TIMEOUT_MS=110000

# Opsional: origin frontend bila memanggil cloud function dari domain lain.
# Pisahkan dengan koma. Untuk same-origin (frontend + functions di EdgeOne), kosongkan.
CORS_ORIGINS=

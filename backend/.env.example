# Salin menjadi .env:  cp .env.example .env   (Windows: copy .env.example .env)
# Semua isian opsional. Dashboard bisa langsung dipakai tanpa .env.

PORT=8787
HOST=127.0.0.1

# Analisis postingan publik Facebook/Instagram/TikTok
# (instal pustaka: pip install -r requirements-optional.txt)
# Batas komentar yang diambil per postingan TikTok/Facebook.
PUBLIC_MAX_COMMENTS=200
# Konteks video: unduh media sementara, transkripsi lokal, dan OCR teks layar.
PUBLIC_ASR=1
PUBLIC_OCR=1
PUBLIC_MAX_MEDIA_SEC=600
PUBLIC_MAX_MEDIA_MB=80
WHISPER_MODEL=small
WHISPER_LANGUAGE=id
OCR_FPS=0.5
OCR_MAX_FRAMES=60
OCR_LANG=ind+eng
# OCR memakai Tesseract bila ada; jika kosong, fallback RapidOCR lokal.
# Isi path tesseract.exe bila tidak ada di PATH.
TESSERACT_CMD=
# Instagram kadang membatasi akses anonim. Isi salah satu bila perlu.
# Jangan pakai akun utama; sesi tersimpan lebih aman daripada password.
IG_USERNAME=
IG_PASSWORD=
IG_SESSIONFILE=

# Analisis lanjutan LLM (EdgeOne Makers Models, endpoint OpenAI-compatible).
# Buat API Key di https://console.tencentcloud.com/edgeone/makers?tab=models&subTab=apikey
# Jangan commit kunci ini. Kosongkan untuk menonaktifkan analisis LLM.
MAKERS_MODELS_KEY=
LLM_ENABLED=1
LLM_BASE_URL=https://ai-gateway.edgeone.link/v1
LLM_MODEL=@makers/deepseek-v4-flash
LLM_TIMEOUT=60
LLM_TOTAL_TIMEOUT=90
LLM_MAX_TOKENS=6144
# Matikan reasoning model agar token tidak habis sebelum JSON selesai.
LLM_DISABLE_THINKING=1
LLM_MAX_ACCOUNTS=30
LLM_MAX_SAMPLES=3

# Keamanan API: samakan nilainya dengan SENTINEL_API_TOKEN di environment EdgeOne.
# Kosongkan untuk menonaktifkan pengecekan token (hanya untuk lokal).
SENTINEL_API_TOKEN=

# CORS hanya diperlukan bila browser memanggil backend langsung, bukan lewat
# cloud-functions EdgeOne. Pisahkan beberapa origin dengan koma.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Environment EdgeOne (Project Settings -> Environment Variables).
# Lokal: salin menjadi .env di root lalu jalankan `edgeone pages dev`.

# Kunci EdgeOne Makers Models (opsional; kosong = LLM nonaktif, heuristik tetap jalan).
MAKERS_MODELS_KEY=
LLM_ENABLED=1
LLM_MODEL=@makers/deepseek-v4-flash
LLM_BASE_URL=https://ai-gateway.edgeone.link/v1
LLM_TIMEOUT=40
LLM_MAX_TOKENS=6144
LLM_DISABLE_THINKING=1
LLM_MAX_ACCOUNTS=30
LLM_MAX_SAMPLES=3

# Transkripsi audio (ASR) lewat API Whisper kompatibel OpenAI. Kosong = ASR nonaktif.
# Groq (gratis, cepat): daftar di console.groq.com. Alternatif OpenAI: ASR_BASE_URL=https://api.openai.com/v1, ASR_MODEL=whisper-1
ASR_API_KEY=
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_MODEL=whisper-large-v3-turbo
ASR_LANGUAGE=id

# Batas komentar per postingan (disarankan <= 200 agar muat waktu 120 dtk).
PUBLIC_MAX_COMMENTS=200

# Opsional Instagram (jangan pakai akun utama).
IG_USERNAME=
IG_PASSWORD=

# Opsional: batasi POST hanya dari origin ini, pisahkan dengan koma.
# Contoh: https://sentinel.edgeone.app
ALLOWED_ORIGINS=
